// =============================================================================
// Exercise 08: Sum to N
// Concepts: Numeric accumulation, input validation, for loop bounds
// Run:      printf '10\n' | umka 08_sum_to_n.um
// =============================================================================

fn main() {
    var n: int32
    var sum: int32

    printf("Enter a positive integer: ")
    scanf("%d", &n)

    if n <= 0 {
        printf("The number must be positive.\n")
        return
    }

    for i := int32(1); i <= n; i++ {
        sum += i
    }

    printf("Sum from 1 to %d = %d\n", n, sum)
}
