import "std.um"

// Returns true if string s begins with the specified prefix
fn startsWith(s: str, prefix: str): bool {
    if len(s) < len(prefix) { return false }
    return slice(s, 0, len(prefix)) == prefix
}

// Scans text character by character to convert **bold** and `code` inline tokens
fn formatInline(text: str): str {
    out := ""
    inBold := false
    inCode := false

    i := 0
    for i < len(text) {
        // Check for ** (bold)
        // TODO: handle inline markup at text[i]. Two '*' in a row (and not inside
        //       code) toggle bold: emit "<strong>" or "</strong>" and skip both
        //       characters (i += 2). A backtick (not inside bold) toggles code with
        //       "<code>" / "</code>" and skips one character. Anything else is copied
        //       through unchanged.
        out += str(text[i])
        i++
    }
    return out
}

// Compiles a multi-line Markdown document into clean HTML
fn compileMarkdown(source: str): str {
    lines := make([]str, 0)
    curLine := ""
    for i := 0; i < len(source); i++ {
        if source[i] == '\n' {
            lines = append(lines, curLine)
            curLine = ""
        } else if source[i] != '\r' {
            curLine += str(source[i])
        }
    }
    if len(curLine) > 0 {
        lines = append(lines, curLine)
    }

    html := ""
    inList := false

    for i := 0; i < len(lines); i++ {
        line := lines[i]

        if len(line) == 0 {
            if inList {
                html += "</ul>\n"
                inList = false
            }
            continue
        }

        if startsWith(line, "### ") {
            if inList { html += "</ul>\n"; inList = false }
            content := slice(line, 4, len(line))
            html += "<h3>" + formatInline(content) + "</h3>\n"
        } else if startsWith(line, "## ") {
            if inList { html += "</ul>\n"; inList = false }
            content := slice(line, 3, len(line))
            html += "<h2>" + formatInline(content) + "</h2>\n"
        } else if startsWith(line, "# ") {
            if inList { html += "</ul>\n"; inList = false }
            content := slice(line, 2, len(line))
            html += "<h1>" + formatInline(content) + "</h1>\n"
        } else if startsWith(line, "> ") {
            if inList { html += "</ul>\n"; inList = false }
            content := slice(line, 2, len(line))
            html += "<blockquote>" + formatInline(content) + "</blockquote>\n"
        // TODO: add an `} else if startsWith(line, "- ") {` branch here for list items. When `inList` is false, first
        //       emit "<ul>\n" and set it true. Then emit "  <li>" + formatInline(content) + "</li>\n"
        //       where content = `slice(line, 2, len(line))`. The closing "</ul>\n" is
        //       already emitted by the other branches and at the end of the file.
        } else {
            if inList { html += "</ul>\n"; inList = false }
            html += "<p>" + formatInline(line) + "</p>\n"
        }
    }

    if inList {
        html += "</ul>\n"
        inList = false
    }

    return html
}

fn main() {
    md := "# Umka Language\n" +
          "Umka is a **statically typed** embeddable scripting language.\n" +
          "## Features\n" +
          "- Clean Go-like syntax\n" +
          "- Fast execution with `bytecode` VM\n" +
          "- Built-in array and hash map collections\n" +
          "> Simplicity is prerequisite for reliability.\n"

    printf("=== Markdown Source ===\n%s\n", md)
    compiled := compileMarkdown(md)
    printf("=== Compiled HTML Output ===\n%s", compiled)
}
