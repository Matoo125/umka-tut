// =============================================================================
// Exercise 19: Fibers and Coroutine Generators
// Concepts: Fibers (`make(fiber, fn)`), cooperative multitasking, yielding (`resume()`), lifecycle
// Task:     Make the two fibers yield Fibonacci numbers and squares back to main
// Run:      umka 19_fibers_coroutines.um
// =============================================================================

// I AM NOT DONE   <- delete this line when you are ready to check your work

var (
    yieldedValue: int
    hasValue: bool
    keepRunning: bool
)

fn fibonacciGenerator() {
    a := 0
    b := 1

    for keepRunning {
        // TODO: publish the current value for the caller: store `a` in
        //       `yieldedValue` and set `hasValue` to true
        resume() // Yield control back to caller

        // TODO: advance the pair (a, b) to the next Fibonacci step
    }
}

fn generateSquares() {
    for i := 1; i <= 5; i++ {
        // TODO: publish i * i the same way (yieldedValue, hasValue)
        resume()
    }
}

fn main() {
    printf("Fibonacci Sequence via Coroutine Fiber:\n")
    keepRunning = true
    fib := make(fiber, fibonacciGenerator)

    for i := 0; i < 10; i++ {
        hasValue = false
        resume(fib)
        if hasValue {
            printf("Fib[%d] = %d\n", i, yieldedValue)
        }
    }

    // Gracefully finish the generator loop so the fiber can be destroyed
    keepRunning = false
    resume(fib)

    printf("\nSquares via Finite Coroutine Fiber:\n")
    sqFib := make(fiber, generateSquares)

    idx := 1
    for valid(sqFib) {
        hasValue = false
        resume(sqFib)
        if valid(sqFib) && hasValue {
            printf("Square #%d = %d\n", idx, yieldedValue)
            idx++
        }
    }
    printf("Generator completed.\n")
}
