import "std.um"

type (
    EventHandler = fn(event: str, data: str)

    EventBus = struct {
        handlers: map[str][]EventHandler
    }
)

// Register a callback function for a specific event topic
fn (bus: ^EventBus) on(event: str, handler: EventHandler) {
    // TODO: make sure `bus.handlers[event]` exists (create it with
    //       `make([]EventHandler, 0)` when `validkey` says it does not), then
    //       append `handler` to that list.
}

// Broadcast an event topic and payload to all registered listeners
fn (bus: ^EventBus) emit(event: str, data: str) {
    // TODO: if anything is registered for `event` (check with `validkey`), call
    //       every handler in its list in order, passing `event` and `data`.
    //       A handler is a function value: `h := list[i]` then `h(event, data)`.
}

// --- Subscriber Handlers ---

fn onUserLogin(event: str, data: str) {
    printf("[Auth Service] User logged in: %s\n", data)
}

fn onAuditLog(event: str, data: str) {
    printf("[Audit Log] Event '%s' triggered with payload: '%s'\n", event, data)
}

fn onUserLogout(event: str, data: str) {
    printf("[Auth Service] User logged out: %s\n", data)
}

fn main() {
    bus := EventBus{handlers: make(map[str][]EventHandler)}

    // Register multiple subscribers to event topics
    bus.on("user:login", onUserLogin)
    bus.on("user:login", onAuditLog)
    bus.on("user:logout", onUserLogout)
    bus.on("user:logout", onAuditLog)

    // Publish events
    printf("=== Dispatching Events ===\n")
    bus.emit("user:login", "alice")
    bus.emit("user:logout", "alice")
}
