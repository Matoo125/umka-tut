import "mat.um"

fn printVec(name: str, v: mat::Vec) {
    printf("%s: [%.2f, %.2f, %.2f]\n", name, v[0], v[1], v[2])
}

fn main() {
    u := mat::Vec{1.0, 2.0, 3.0}
    v := mat::Vec{4.0, 5.0, 6.0}

    printf("Vector Math:\n")
    printVec("u", u)
    printVec("v", v)

    // TODO: u and v are mat::Vec; compute with their methods
    //       add(v), sub(v), dot(v), cross(v) and norm()
    var add, sub, cross: mat::Vec
    dot := 0.0
    normU := 0.0
    normV := 0.0

    printVec("u + v", add)
    printVec("u - v", sub)
    printf("u . v: %.2f\n", dot)
    printVec("u x v", cross)
    printf("|u|: %.4f\n", normU)
    printf("|v|: %.4f\n", normV)

    printf("\nMatrix Transformation:\n")
    // TODO: build the identity with mat::identity() and multiply it by u
    //       with its mulv(u) method
    var transformed: mat::Vec
    printVec("I * u", transformed)
}
