import "utf8.um"

fn main() {
    text := "Hello, 世界! 🌍"
    byteLen := len(text)
    // TODO: count code points (not bytes) with a function from utf8.um
    runeLen := 0

    printf("Original Text: %s\n", text)
    printf("Byte Length:   %d\n", byteLen)
    printf("Rune Length:   %d\n", runeLen)
    printf("\nDecoded Code Points:\n")

    runes := utf8::decode(text)
    for i, r in runes {
        // TODO: print "[%02d] U+%04X | %d bytes | Char: %s" for each rune:
