fn main() {
    var n: int32
    var sum: int32

    printf("Enter a positive integer: ")
    scanf("%d", &n)

    if n <= 0 {
        printf("The number must be positive.\n")
        return
    }

    // TODO: add every whole number from 1 up to and including n to `sum`
