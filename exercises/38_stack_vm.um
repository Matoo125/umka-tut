// =============================================================================
// 38_stack_vm.um - Stack-Based Bytecode Virtual Machine in Umka
// Task:     Make the VM execute every opcode so both bytecode programs print the right result.
// Run:      umka 38_stack_vm.um
// =============================================================================

// I AM NOT DONE   <- delete this line when you are ready to check your work

import (
	"std.um"
)

type (
	Opcode = enum {
		OP_PUSH
		OP_ADD
		OP_SUB
		OP_MUL
		OP_DIV
		OP_CMP_EQ
		OP_CMP_LT
		OP_JMP
		OP_JNZ
		OP_DUP
		OP_OVER
		OP_SWAP
		OP_DROP
		OP_PRINT
		OP_HALT
	}

	Instr = struct {
		op: Opcode
		arg: int
	}

	VM = struct {
		stack: [128]int
		sp: int
		ip: int
		running: bool
	}
)

fn (vm: ^VM) push(val: int) {
	if vm.sp >= 128 {
		std::println("Error: Stack overflow")
		vm.running = false
		return
	}
	vm.stack[vm.sp] = val
	vm.sp++
}

fn (vm: ^VM) pop(): int {
	if vm.sp <= 0 {
		std::println("Error: Stack underflow")
		vm.running = false
		return 0
	}
	vm.sp--
	return vm.stack[vm.sp]
}

fn (vm: ^VM) run(program: []Instr) {
	vm.sp = 0
	vm.ip = 0
	vm.running = true

	for vm.running && vm.ip >= 0 && vm.ip < len(program) {
		inst := program[vm.ip]
		vm.ip++

		switch inst.op {
		case Opcode.OP_PUSH:
			vm.push(inst.arg)

		case Opcode.OP_ADD:
			b := vm.pop()
			a := vm.pop()
			vm.push(a + b)

		case Opcode.OP_SUB:
			b := vm.pop()
			a := vm.pop()
			vm.push(a - b)

		// TODO: OP_MUL works like OP_ADD and OP_SUB above (pop `b`, then `a`,
		//       push `a * b`).
		// TODO: OP_DIV: same, but if `b == 0` print "Error: Division by zero"
		//       and set `vm.running = false` instead of pushing.
		// TODO: OP_CMP_EQ and OP_CMP_LT: pop `b`, then `a`; push 1 if `a == b`
		//       (respectively `a < b`), else 0.
		// TODO: OP_JMP sets `vm.ip = inst.arg`. OP_JNZ pops a condition and
		//       jumps the same way only when it is not zero.
		// TODO: OP_DUP (a -> a a), OP_OVER (a b -> a b a), OP_SWAP (a b -> b a)
		//       and OP_DROP (a ->): all done with `vm.pop()` and `vm.push()`.
		//       Pop the top value first, so `b` comes off before `a`.

		case Opcode.OP_PRINT:
			val := vm.pop()
			printf("Result: %d\n", val)

		case Opcode.OP_HALT:
			vm.running = false

		default:
			printf("Error: Unknown opcode %d\n", int(inst.op))
			vm.running = false
		}
	}
}

fn main() {
	std::println("=== Stack-Based Bytecode VM ===")

	// Program 1: Arithmetic Expression Evaluation
	// Computes: (7 + 3) * 4 - 5 = 35
	std::println("Running Program 1: (7 + 3) * 4 - 5")
	p1 := []Instr{
		Instr{op: Opcode.OP_PUSH,  arg: 7},
		Instr{op: Opcode.OP_PUSH,  arg: 3},
		Instr{op: Opcode.OP_ADD,   arg: 0},
		Instr{op: Opcode.OP_PUSH,  arg: 4},
		Instr{op: Opcode.OP_MUL,   arg: 0},
		Instr{op: Opcode.OP_PUSH,  arg: 5},
		Instr{op: Opcode.OP_SUB,   arg: 0},
		Instr{op: Opcode.OP_PRINT, arg: 0},
		Instr{op: Opcode.OP_HALT,  arg: 0}
	}

	vm := VM{}
	vm.run(p1)

	// Program 2: Triangular sum of 5: 5 + 4 + 3 + 2 + 1 = 15
	// The stack holds [acc, n]; every pass adds n to acc and counts n down.
	//  0: PUSH 0      -> [0]                 acc
	//  1: PUSH 5      -> [0, 5]              acc, n
	//  2: DUP         -> [acc, n, n]         the loop check
	//  3: JNZ 5       -> n != 0: jump to the body at 5 (pops the copy)
	//  4: JMP 12      -> n == 0: jump to the exit
	//  5: SWAP        -> [n, acc]            the loop body
	//  6: OVER        -> [n, acc, n]
	//  7: ADD         -> [n, acc + n]
	//  8: SWAP        -> [acc + n, n]
	//  9: PUSH 1      -> [acc + n, n, 1]
	// 10: SUB         -> [acc + n, n - 1]
	// 11: JMP 2       -> back to the loop check
	// 12: DROP        -> drops n (0), leaves [acc]
	// 13: PRINT       -> prints acc
	// 14: HALT
	std::println("Running Program 2: Triangular sum of 5")
	p2 := []Instr{
		Instr{op: Opcode.OP_PUSH,  arg: 0},
		Instr{op: Opcode.OP_PUSH,  arg: 5},
		Instr{op: Opcode.OP_DUP,   arg: 0},
		Instr{op: Opcode.OP_JNZ,   arg: 5},
		Instr{op: Opcode.OP_JMP,   arg: 12},
		Instr{op: Opcode.OP_SWAP,  arg: 0},
		Instr{op: Opcode.OP_OVER,  arg: 0},
		Instr{op: Opcode.OP_ADD,   arg: 0},
		Instr{op: Opcode.OP_SWAP,  arg: 0},
		Instr{op: Opcode.OP_PUSH,  arg: 1},
		Instr{op: Opcode.OP_SUB,   arg: 0},
		Instr{op: Opcode.OP_JMP,   arg: 2},
		Instr{op: Opcode.OP_DROP,  arg: 0},
		Instr{op: Opcode.OP_PRINT, arg: 0},
		Instr{op: Opcode.OP_HALT,  arg: 0}
	}

	vm.run(p2)
	std::println("VM execution completed successfully.")
}
