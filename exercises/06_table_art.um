// I AM NOT DONE   <- delete this line when you are ready to check your work

fn drawTable(width: int, height: int) {
    // Top border
    printf("+")
    for i := 1; i <= width - 2; i++ {
        printf("-")
    }
    printf("+\n")

    // TODO: print the middle rows: height - 2 lines, each a "|", then
    //       width - 2 spaces, then "|" and a newline

    // TODO: print the bottom border, the same as the top one
}

fn main() {
    var w, h: int32

    printf("Enter table width: ")
    scanf("%d", &w)

    printf("Enter table height: ")
    scanf("%d", &h)

    if w < 2 || h < 2 {
        printf("Width and height must be at least 2.\n")
        return
    }

    drawTable(w, h)
}
