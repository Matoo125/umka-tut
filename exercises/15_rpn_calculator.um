import "std.um"

type RpnStack = struct {
    items: []real
}

fn (s: ^RpnStack) push(val: real) {
    s.items = append(s.items, val)
}

fn (s: ^RpnStack) pop(): (real, bool) {
    // TODO: if the stack is empty return 0.0, false. Otherwise take the last
    //       item (index n - 1), remove it from the slice with
    //       `delete(s.items, n - 1)`, and return it together with true.
    return 0.0, false
}

fn (s: ^RpnStack) len(): int {
    return len(s.items)
}

fn evaluateRPN(tokens: []str): (real, bool) {
    var st: RpnStack
    st.items = make([]real, 0)

    // TODO: for each token: if it is an operator (+ - * /), pop b first and
    //       then a (order matters for - and /), fail if either pop failed,
    //       and push the result of `a <op> b`; fail on division by zero.
    //       Otherwise it is a number: parse it with
    //       `sscanf(tok, "%lf", &val)` (returns 1 on success) and push it.
    //       Any failure means `return 0.0, false`.
    for i, tok in tokens {
    }

    if st.len() != 1 {
        return 0.0, false
    }

    result, _ := st.pop()
    return result, true
}

fn splitTokens(expr: str): []str {
    tokens := make([]str, 0)
    var cur: str
    cur = ""

    for i := 0; i < len(expr); i++ {
        ch := expr[i]
        if ch == ' ' || ch == '\t' || ch == '\n' {
            if len(cur) > 0 {
                tokens = append(tokens, cur)
                cur = ""
            }
        } else {
            cur += str(ch)
        }
    }

    if len(cur) > 0 {
        tokens = append(tokens, cur)
    }

    return tokens
}

fn main() {
    printf("RPN Calculator\n")
    printf("Enter number of tokens: ")
    var n: int32
    if scanf("%d", &n) != 1 || n <= 0 {
        printf("Invalid token count.\n")
        return
    }

    tokens := make([]str, 0)
    printf("Enter %d tokens separated by whitespace:\n", n)
    for i := 0; i < n; i++ {
        var tok: str
        scanf("%s", &tok)
        tokens = append(tokens, tok)
    }

    res, ok := evaluateRPN(tokens)
    if ok {
        printf("Result: %.4f\n", res)
    } else {
        printf("Evaluation error: invalid RPN expression.\n")
    }
}
