// =============================================================================
// 46_lr_parser.um - LR Shift-Reduce Parser State Machine in Umka
// Task:     Fill in the SLR action table and the shift/reduce steps so the input `id + id + id` is accepted.
// Run:      umka 46_lr_parser.um
// =============================================================================

// I AM NOT DONE   <- delete this line when you are ready to check your work

import (
	"std.um"
)

type (
	ActionType = enum {
		ACT_SHIFT
		ACT_REDUCE
		ACT_ACCEPT
		ACT_ERROR
	}

	Action = struct {
		actType: ActionType
		val: int
	}

	Rule = struct {
		lhs: str
		rhsLen: int
		desc: str
	}
)

fn getAction(state: int, tok: str): Action {
	// LR(0) / SLR(1) parsing table for grammar:
	// (1) E -> E + T
	// (2) E -> T
	// (3) T -> id
	//
	// States:
	// State 0: on 'id' -> Shift 2
	// State 1: on '+'  -> Shift 4, on '$' -> Accept
	// State 2: reduce (3) T -> id
	// State 3: reduce (2) E -> T
	// State 4: on 'id' -> Shift 2
	// State 5: reduce (1) E -> E + T

	// TODO: encode the table from the comment above. `switch state`, and in
	//       each case return an Action: ACT_SHIFT with val = the state to
	//       push, ACT_REDUCE with val = the rule number (index into `rules`
	//       in main), or ACT_ACCEPT. Some states depend on `tok`; when no
	//       entry matches, fall through to the ACT_ERROR below.

	return Action{actType: ActionType.ACT_ERROR, val: 0}
}

fn getGoto(state: int, nonTerm: str): int {
	if state == 0 {
		if nonTerm == "E" { return 1 }
		if nonTerm == "T" { return 3 }
	} else if state == 4 {
		if nonTerm == "T" { return 5 }
	}
	return -1
}

fn formatStateStack(states: []int): str {
	s := "[ "
	for i := 0; i < len(states); i++ {
		s += sprintf("%d ", states[i])
	}
	s += "]"
	return s
}

fn formatSymbolStack(syms: []str): str {
	s := "[ "
	for i := 0; i < len(syms); i++ {
		s += syms[i] + " "
	}
	s += "]"
	return s
}

fn main() {
	std::println("=== LR Shift-Reduce Parser State Machine ===")
	std::println("Grammar Rules:")
	std::println("  (1) E -> E + T")
	std::println("  (2) E -> T")
	std::println("  (3) T -> id\n")

	rules := [4]Rule{
		Rule{lhs: "S'", rhsLen: 1, desc: "S' -> E"},
		Rule{lhs: "E",  rhsLen: 3, desc: "E -> E + T"},
		Rule{lhs: "E",  rhsLen: 1, desc: "E -> T"},
		Rule{lhs: "T",  rhsLen: 1, desc: "T -> id"}
	}

	inputTokens := []str{"id", "+", "id", "+", "id", "$"}

	std::println("Parsing Input: id + id + id\n")
	printf("%-4s  %-16s %-20s %s\n", "Step", "State Stack", "Symbol Stack", "Action")
	std::println("------------------------------------------------------------")

	stateStack := []int{0}
	symbolStack := []str{"$"}
	ip := 0
	step := 0
	running := true
	success := false

	for running {
		currState := stateStack[len(stateStack) - 1]
		currTok := inputTokens[ip]
		act := getAction(currState, currTok)

		stateStr := formatStateStack(stateStack)
		symStr := formatSymbolStack(symbolStack)

		switch act.actType {
		case ActionType.ACT_SHIFT:
			actDesc := sprintf("Shift %d", act.val)
			printf("%2d    %-16s %-20s %s\n", step, stateStr, symStr, actDesc)
			// TODO: shift: push the current token onto `symbolStack`, push
			//       `act.val` (the new state) onto `stateStack`, and advance
			//       the input with `ip++`.
			running = false

		case ActionType.ACT_REDUCE:
			// TODO: reduce by rule `act.val` (look it up in `rules`). Print the
			//       step line like the shift case, with the text
			//       "Reduce (<n>) <rule desc>". Then pop `rhsLen` entries off
			//       both stacks (`delete(list, index)` removes one element),
			//       ask getGoto(top state, rule.lhs) for the next state, and
			//       push the rule's `lhs` symbol and that state. A goto of -1
			//       is an error: print a message and stop the loop.
			running = false

		case ActionType.ACT_ACCEPT:
			printf("%2d    %-16s %-20s %s\n", step, stateStr, symStr, "Accept")
			running = false
			success = true

		case ActionType.ACT_ERROR:
			printf("%2d    %-16s %-20s %s\n", step, stateStr, symStr, "Syntax Error")
			running = false
		}

		step++
	}

	std::println("")
	if success {
		std::println("Parse Result: SUCCESS (Input fully accepted by grammar)")
	} else {
		std::println("Parse Result: FAILED")
	}
}
