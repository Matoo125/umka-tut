// =============================================================================
// Exercise 35: Circular Ring Buffer (Bounded Queue)
// Concepts: Fixed-capacity slices (`make([]int, cap)`), modular arithmetic
//           (`(i + 1) % cap`), FIFO queue semantics, overflow rejection, and
//           circular indexing.
// Task:     Implement push and pop of the circular buffer with wrap-around indexes
// Run:      umka 35_ring_buffer.um
// =============================================================================

// I AM NOT DONE   <- delete this line when you are ready to check your work

import "std.um"

type (
    RingBuffer = struct {
        data: []int
        capacity: int
        head: int
        tail: int
        size: int
    }
)

// Initializes a pre-allocated fixed-capacity ring buffer
fn makeRingBuffer(cap: int): RingBuffer {
    return RingBuffer{
        data: make([]int, cap),
        capacity: cap,
        head: 0,
        tail: 0,
        size: 0
    }
}

// Appends an item to the buffer; returns false if buffer is full
fn (rb: ^RingBuffer) push(val: int): bool {
    // TODO: if the buffer is full (`size >= capacity`) return false. Otherwise
    //       store `val` at `data[tail]`, advance `tail` with wrap-around
    //       (`(tail + 1) % capacity`), increment `size` and return true.
    return false
}

// Dequeues the oldest item; returns -1 if buffer is empty
fn (rb: ^RingBuffer) pop(): int {
    // TODO: if the buffer is empty return -1. Otherwise read `data[head]`,
    //       advance `head` with wrap-around, decrement `size` and return the value.
    return -1
}

// Prints the current buffer elements in chronological order from head to tail
fn (rb: ^RingBuffer) printState() {
    printf("RingBuffer (size=%d/%d, head=%d, tail=%d): [ ", rb.size, rb.capacity, rb.head, rb.tail)
    for i := 0; i < rb.size; i++ {
        idx := (rb.head + i) % rb.capacity
        printf("%d ", rb.data[idx])
    }
    printf("]\n")
}

fn main() {
    rb := makeRingBuffer(4)

    printf("=== Circular Ring Buffer (Capacity = 4) ===\n")
    printf("Enqueue 10, 20, 30:\n")
    rb.push(10)
    rb.push(20)
    rb.push(30)
    rb.printState()

    printf("Dequeue one item: %d\n", rb.pop())
    rb.printState()

    printf("Enqueue 40, 50 (wraps around):\n")
    rb.push(40)
    rb.push(50)
    rb.printState()

    printf("Attempt overflow enqueue 60: %s\n", rb.push(60) ? "success" : "rejected (buffer full)")
    rb.printState()

    printf("Draining all items:\n")
    for rb.size > 0 {
        printf("Popped: %d\n", rb.pop())
    }
    rb.printState()
}
