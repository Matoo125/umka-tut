// =============================================================================
// Exercise 05: Multiplication Table
// Concepts: Nested `for` loops, field width specifiers (`%4d`), input validation
// Run:      printf '4\n' | umka 05_multiplication_table.um
// =============================================================================

fn main() {
    var size: int32

    printf("Enter table size: ")
    scanf("%d", &size)

    if size <= 0 {
        printf("Table size must be positive.\n")
        return
    }

    for row := 1; row <= size; row++ {
        for col := 1; col <= size; col++ {
            printf("%4d", row * col)
        }
        printf("\n")
    }
}
