// =============================================================================
// Exercise 34: Run-Length Encoding (RLE) Byte Stream Compressor
// Concepts: Byte buffer slices (`[]uint8`), run scanning, count-value chunking,
//           lossless decompression, and compression ratio calculation.
// Run:      umka 34_rle_compressor.um
// =============================================================================

import "std.um"

// Compresses a byte slice using Run-Length Encoding into pairs of [count, value]
fn compressRLE(input: []uint8): []uint8 {
    out := make([]uint8, 0)
    if len(input) == 0 { return out }

    run := 1
    for i := 1; i < len(input); i++ {
        if input[i] == input[i - 1] && run < 255 {
            run++
        } else {
            out = append(out, uint8(run))
            out = append(out, input[i - 1])
            run = 1
        }
    }

    out = append(out, uint8(run))
    out = append(out, input[len(input) - 1])
    return out
}

// Expands an RLE stream of [count, value] pairs back into the raw byte slice
fn decompressRLE(comp: []uint8): []uint8 {
    out := make([]uint8, 0)
    for i := 0; i < len(comp); i += 2 {
        count := int(comp[i])
        val := comp[i + 1]
        for c := 0; c < count; c++ {
            out = append(out, val)
        }
    }
    return out
}

fn main() {
    // 17-byte raw input buffer with runs of identical bytes
    raw := make([]uint8, 17)
    for i := 0; i < 5; i++ { raw[i] = 0xAA }  // 5x 0xAA
    for i := 5; i < 8; i++ { raw[i] = 0xBB }  // 3x 0xBB
    for i := 8; i < 16; i++ { raw[i] = 0xCC } // 8x 0xCC
    raw[16] = 0xDD                           // 1x 0xDD

    compressed := compressRLE(raw)
    decompressed := decompressRLE(compressed)

    printf("=== Run-Length Encoding (RLE) Stream Compressor ===\n")
    printf("Original size:     %d bytes\n", len(raw))
    printf("Compressed size:   %d bytes\n", len(compressed))

    reduction := (1.0 - real(len(compressed)) / real(len(raw))) * 100.0
    printf("Space saved:       %.1f%%\n", reduction)

    printf("Compressed stream: [ ")
    for i := 0; i < len(compressed); i += 2 {
        printf("(%d x 0x%02X) ", int(compressed[i]), int(compressed[i + 1]))
    }
    printf("]\n")

    matches := (len(decompressed) == len(raw))
    if matches {
        for i := 0; i < len(raw); i++ {
            if decompressed[i] != raw[i] {
                matches = false
                break
            }
        }
    }

    printf("Verification:      %s\n", matches ? "PASS (Exact byte match)" : "FAIL")
}
