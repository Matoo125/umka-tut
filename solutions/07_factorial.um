// =============================================================================
// Exercise 07: Factorial
// Concepts: Iterative loops, multiplicative accumulator, non-negative validation
// Run:      printf '5\n' | umka 07_factorial.um
// =============================================================================

fn main() {
    var n: int32
    var result: int32 = 1

    printf("Enter a non-negative integer: ")
    scanf("%d", &n)

    if n < 0 {
        printf("Factorial is only defined for non-negative integers.\n")
        return
    }

    for i := int32(2); i <= n; i++ {
        result *= i
    }

    printf("%d! = %d\n", n, result)
}
