// =============================================================================
// 49_register_vm.um
// Exercise 49: Register-Based Virtual Machine
//
// Demonstrates a 3-address register virtual machine with 16 registers,
// instruction decoding, disassembly, and iterative Fibonacci calculation.
// Run:      umka 49_register_vm.um
// =============================================================================

import (
    "std.um"
)

const (
    OP_HALT  = 0
    OP_LOADI = 1
    OP_MOV   = 2
    OP_ADD   = 3
    OP_SUB   = 4
    OP_MUL   = 5
    OP_CMP   = 6
    OP_JMP   = 7
    OP_JEQ   = 8
    OP_JLT   = 9
    OP_PRINT = 10
)

type Instruction = struct {
    op: int
    rd: int
    rs1: int
    rs2: int
    imm: int
}

type VM = struct {
    regs: [16]int
    pc: int
    cmpLt: bool
    cmpEq: bool
    cycles: int
    running: bool
}

fn opName(op: int): str {
    switch op {
        case OP_HALT:  return "HALT"
        case OP_LOADI: return "LOADI"
        case OP_MOV:   return "MOV"
        case OP_ADD:   return "ADD"
        case OP_SUB:   return "SUB"
        case OP_MUL:   return "MUL"
        case OP_CMP:   return "CMP"
        case OP_JMP:   return "JMP"
        case OP_JEQ:   return "JEQ"
        case OP_JLT:   return "JLT"
        case OP_PRINT: return "PRINT"
    }
    return "UNKNOWN"
}

fn disassemble(code: []Instruction) {
    for i := 0; i < len(code); i++ {
        inst := code[i]
        name := opName(inst.op)
        switch inst.op {
            case OP_HALT:
                printf(" %2d: %s\n", i, name)
            case OP_LOADI:
                printf(" %2d: %-6s R%d, %d\n", i, name, inst.rd, inst.imm)
            case OP_MOV:
                printf(" %2d: %-6s R%d, R%d\n", i, name, inst.rd, inst.rs1)
            case OP_ADD, OP_SUB, OP_MUL:
                printf(" %2d: %-6s R%d, R%d, R%d\n", i, name, inst.rd, inst.rs1, inst.rs2)
            case OP_CMP:
                printf(" %2d: %-6s R%d, R%d\n", i, name, inst.rs1, inst.rs2)
            case OP_JMP, OP_JEQ, OP_JLT:
                printf(" %2d: %-6s %d\n", i, name, inst.imm)
            case OP_PRINT:
                printf(" %2d: %-6s R%d\n", i, name, inst.rs1)
        }
    }
}

fn runVM(vm: ^VM, code: []Instruction) {
    vm.running = true
    for vm.running {
        if vm.pc < 0 || vm.pc >= len(code) {
            printf("Error: PC %d out of bounds\n", vm.pc)
            vm.running = false
            break
        }

        inst := code[vm.pc]
        vm.pc++
        vm.cycles++

        switch inst.op {
            case OP_HALT:
                vm.running = false

            case OP_LOADI:
                vm.regs[inst.rd] = inst.imm

            case OP_MOV:
                vm.regs[inst.rd] = vm.regs[inst.rs1]

            case OP_ADD:
                vm.regs[inst.rd] = vm.regs[inst.rs1] + vm.regs[inst.rs2]

            case OP_SUB:
                vm.regs[inst.rd] = vm.regs[inst.rs1] - vm.regs[inst.rs2]

            case OP_MUL:
                vm.regs[inst.rd] = vm.regs[inst.rs1] * vm.regs[inst.rs2]

            case OP_CMP:
                vm.cmpLt = vm.regs[inst.rs1] < vm.regs[inst.rs2]
                vm.cmpEq = vm.regs[inst.rs1] == vm.regs[inst.rs2]

            case OP_JMP:
                vm.pc = inst.imm

            case OP_JEQ:
                if vm.cmpEq {
                    vm.pc = inst.imm
                }

            case OP_JLT:
                if vm.cmpLt {
                    vm.pc = inst.imm
                }

            case OP_PRINT:
                printf("[OUTPUT] %d\n", vm.regs[inst.rs1])
        }
    }
}

fn main() {
    printf("=== Register-Based Virtual Machine ===\n")
    printf("Registers: 16 (R0..R15)\n")
    printf("Program: Iterative Fibonacci(10)\n\n")

    code := []Instruction{
        Instruction{op: OP_LOADI, rd: 0, imm: 0},       // 0: LOADI R0, 0 (a = 0)
        Instruction{op: OP_LOADI, rd: 1, imm: 1},       // 1: LOADI R1, 1 (b = 1)
        Instruction{op: OP_LOADI, rd: 2, imm: 10},      // 2: LOADI R2, 10 (n = 10)
        Instruction{op: OP_LOADI, rd: 3, imm: 0},       // 3: LOADI R3, 0 (i = 0)
        Instruction{op: OP_CMP,   rs1: 3, rs2: 2},      // 4: CMP R3, R2
        Instruction{op: OP_JEQ,   imm: 12},             // 5: JEQ 12
        Instruction{op: OP_ADD,   rd: 4, rs1: 0, rs2: 1}, // 6: ADD R4, R0, R1
        Instruction{op: OP_MOV,   rd: 0, rs1: 1},       // 7: MOV R0, R1
        Instruction{op: OP_MOV,   rd: 1, rs1: 4},       // 8: MOV R1, R4
        Instruction{op: OP_LOADI, rd: 5, imm: 1},       // 9: LOADI R5, 1
        Instruction{op: OP_ADD,   rd: 3, rs1: 3, rs2: 5}, // 10: ADD R3, R3, R5
        Instruction{op: OP_JMP,   imm: 4},              // 11: JMP 4
        Instruction{op: OP_PRINT, rs1: 0},              // 12: PRINT R0
        Instruction{op: OP_HALT}                        // 13: HALT
    }

    printf("Disassembly:\n")
    disassemble(code)

    printf("\nExecution:\n")
    var vm: VM
    runVM(&vm, code)

    printf("Cycles executed: %d\n", vm.cycles)
    printf("Final registers:\n")
    printf("  R0: %d\n", vm.regs[0])
    printf("  R1: %d\n", vm.regs[1])
    printf("  R2: %d\n", vm.regs[2])
    printf("  R3: %d\n", vm.regs[3])
}
