// =============================================================================
// Exercise 23: Unicode and UTF-8 Decoding
// Concepts: Standard library `utf8.um`, `Rune` code points, byte vs rune length, `encode()`
// Run:      umka 23_unicode_utf8.um
// =============================================================================

import "utf8.um"

fn main() {
    text := "Hello, 世界! 🌍"
    byteLen := len(text)
    runeLen := utf8::runeCount(text)

    printf("Original Text: %s\n", text)
    printf("Byte Length:   %d\n", byteLen)
    printf("Rune Length:   %d\n", runeLen)
    printf("\nDecoded Code Points:\n")

    runes := utf8::decode(text)
    for i, r in runes {
        printf("[%02d] U+%04X | %d bytes | Char: %s\n", i, r, r.size(), r.encode())
    }
}
