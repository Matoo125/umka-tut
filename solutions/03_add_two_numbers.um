// =============================================================================
// Exercise 03: Add Two Numbers
// Concepts: Formatted console input (`scanf`), pointer arguments, floating point addition
// Run:      printf '1\n2\n' | umka 03_add_two_numbers.um
// =============================================================================

fn main() {
    var a, b: real32

    printf("Enter first number: ")
    scanf("%f", &a)

    printf("Enter second number: ")
    scanf("%f", &b)

    printf("Result: %f\n", a + b)
}
