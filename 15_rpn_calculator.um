// =============================================================================
// Exercise 15: Reverse Polish Notation (RPN) Calculator
// Concepts: Stack data structures, struct receiver methods, multi-value returns, token parsing
// Run:      umka 15_rpn_calculator.um
// =============================================================================

import "std.um"

type RpnStack = struct {
    items: []real
}

fn (s: ^RpnStack) push(val: real) {
    s.items = append(s.items, val)
}

fn (s: ^RpnStack) pop(): (real, bool) {
    n := len(s.items)
    if n == 0 {
        return 0.0, false
    }
    val := s.items[n - 1]
    s.items = delete(s.items, n - 1)
    return val, true
}

fn (s: ^RpnStack) len(): int {
    return len(s.items)
}

fn evaluateRPN(tokens: []str): (real, bool) {
    var st: RpnStack
    st.items = make([]real, 0)

    for i, tok in tokens {
        if tok == "+" || tok == "-" || tok == "*" || tok == "/" {
            b, okB := st.pop()
            a, okA := st.pop()
            if !okA || !okB {
                return 0.0, false
            }

            if tok == "+" {
                st.push(a + b)
            } else if tok == "-" {
                st.push(a - b)
            } else if tok == "*" {
                st.push(a * b)
            } else if tok == "/" {
                if b == 0.0 {
                    return 0.0, false
                }
                st.push(a / b)
            }
        } else {
            var val: real
            if sscanf(tok, "%lf", &val) != 1 {
                return 0.0, false
            }
            st.push(val)
        }
    }

    if st.len() != 1 {
        return 0.0, false
    }

    result, _ := st.pop()
    return result, true
}

fn splitTokens(expr: str): []str {
    tokens := make([]str, 0)
    var cur: str
    cur = ""

    for i := 0; i < len(expr); i++ {
        ch := expr[i]
        if ch == ' ' || ch == '\t' || ch == '\n' {
            if len(cur) > 0 {
                tokens = append(tokens, cur)
                cur = ""
            }
        } else {
            cur += str(ch)
        }
    }

    if len(cur) > 0 {
        tokens = append(tokens, cur)
    }

    return tokens
}

fn main() {
    printf("RPN Calculator\n")
    printf("Enter number of tokens: ")
    var n: int32
    if scanf("%d", &n) != 1 || n <= 0 {
        printf("Invalid token count.\n")
        return
    }

    tokens := make([]str, 0)
    printf("Enter %d tokens separated by whitespace:\n", n)
    for i := 0; i < n; i++ {
        var tok: str
        scanf("%s", &tok)
        tokens = append(tokens, tok)
    }

    res, ok := evaluateRPN(tokens)
    if ok {
        printf("Result: %.4f\n", res)
    } else {
        printf("Evaluation error: invalid RPN expression.\n")
    }
}
