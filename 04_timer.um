import "std.um"

fn main() {
    startTime := std::clock()
    reversed := false        // false = counting forward, true = counting backward
    var elapsed: real        // in seconds
    var input: str

    printf("Timer started!\n")
    printf("Press: L = lapse, R = reverse, S = stop\n\n")

    input = ""
    for input != "S" {
        printf("Command: ")
        scanf("%s", &input)

        // Calculate elapsed time
        elapsed = std::clock() - startTime

        // Apply reverse mode
        if reversed {
            elapsed = -elapsed
        }

        if input == "L" {
            printf("Elapsed time: %.3f seconds\n", elapsed)
        } else if input == "R" {
            reversed = !reversed
            if reversed {
                printf("Reverse mode: ON\n")
            } else {
                printf("Reverse mode: OFF\n")
            }
        } else if input == "S" {
            printf("Final time: %.3f seconds\n", elapsed)
            printf("Timer stopped.\n")
        } else {
            printf("Unknown command.\n")
        }
    }
}
