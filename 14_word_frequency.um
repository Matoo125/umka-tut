// Exercise 14: Word Frequency Counter
// Practices: maps, string slicing/iteration, validkey, len, and map lookup

import "std.um"

fn isLetter(ch: char): bool {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
}

fn toLower(ch: char): char {
    if ch >= 'A' && ch <= 'Z' {
        return char(int(ch) + 32)
    }
    return ch
}

fn tokenize(text: str): []str {
    words := make([]str, 0)
    var current: str
    current = ""

    for i := 0; i < len(text); i++ {
        ch := text[i]
        if isLetter(ch) {
            current += str(toLower(ch))
        } else {
            if len(current) > 0 {
                words = append(words, current)
                current = ""
            }
        }
    }

    if len(current) > 0 {
        words = append(words, current)
    }

    return words
}

fn countWords(words: []str): map[str]int {
    counts := make(map[str]int)
    for i, w in words {
        if validkey(counts, w) {
            counts[w] = counts[w] + 1
        } else {
            counts[w] = 1
        }
    }
    return counts
}

fn main() {
    sample := "To be, or not to be: that is the question. To be is to live!"
    printf("Input text:\n\"%s\"\n\n", sample)

    words := tokenize(sample)
    counts := countWords(words)
    wordKeys := keys(counts)

    printf("Word counts (%d unique words, %d total):\n", len(wordKeys), len(words))
    for i, w in wordKeys {
        printf("%-10s: %d\n", w, counts[w])
    }
}
