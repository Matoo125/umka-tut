// 41_huffman_coding.um - Huffman Coding & Data Compression in Umka

import (
	"std.um"
)

type (
	HuffNode = struct {
		ch: char
		freq: int
		isLeaf: bool
		left: ^HuffNode
		right: ^HuffNode
	}

	CodeEntry = struct {
		ch: char
		code: str
	}
)

fn createLeaf(ch: char, freq: int): ^HuffNode {
	n := new(HuffNode)
	n.ch = ch
	n.freq = freq
	n.isLeaf = true
	n.left = null
	n.right = null
	return n
}

fn createInternal(left, right: ^HuffNode): ^HuffNode {
	n := new(HuffNode)
	n.ch = '\0'
	n.freq = left.freq + right.freq
	n.isLeaf = false
	n.left = left
	n.right = right
	return n
}

// Global code table
var codeTable: []CodeEntry

fn buildCodes(node: ^HuffNode, prefix: str) {
	if node == null {
		return
	}
	if node.isLeaf {
		// Single character edge case
		c := prefix
		if len(c) == 0 {
			c = "0"
		}
		codeTable = append(codeTable, CodeEntry{ch: node.ch, code: c})
		return
	}
	buildCodes(node.left, prefix + "0")
	buildCodes(node.right, prefix + "1")
}

fn getCode(ch: char): str {
	for i := 0; i < len(codeTable); i++ {
		if codeTable[i].ch == ch {
			return codeTable[i].code
		}
	}
	return ""
}

fn main() {
	std::println("=== Huffman Coding & Compression ===")

	text := "abracadabra"
	printf("Input text: \"%s\"\n", text)
	origBits := len(text) * 8
	printf("Original size: %d characters (%d bits at 8 bits/char)\n\n", len(text), origBits)

	// Step 1: Count character frequencies in order of first appearance
	uniqueChars := make([]char, 0)
	freqs := make([]int, 0)

	for i := 0; i < len(text); i++ {
		ch := text[i]
		found := false
		for j := 0; j < len(uniqueChars); j++ {
			if uniqueChars[j] == ch {
				freqs[j]++
				found = true
				break
			}
		}
		if !found {
			uniqueChars = append(uniqueChars, ch)
			freqs = append(freqs, 1)
		}
	}

	std::println("Character Frequencies:")
	for i := 0; i < len(uniqueChars); i++ {
		printf("  '%c': %d\n", uniqueChars[i], freqs[i])
	}
	std::println("")

	// Step 2: Initialize forest with leaf nodes
	forest := make([]^HuffNode, len(uniqueChars))
	for i := 0; i < len(uniqueChars); i++ {
		forest[i] = createLeaf(uniqueChars[i], freqs[i])
	}

	// Step 3: Repeatedly merge two nodes with smallest frequencies
	// For deterministic tie-breaking, preserve stable scanning
	for len(forest) > 1 {
		// Find first minimum
		min1Idx := 0
		for i := 1; i < len(forest); i++ {
			if forest[i].freq < forest[min1Idx].freq {
				min1Idx = i
			}
		}
		node1 := forest[min1Idx]
		forest = delete(forest, min1Idx)

		// Find second minimum
		min2Idx := 0
		for i := 1; i < len(forest); i++ {
			if forest[i].freq < forest[min2Idx].freq {
				min2Idx = i
			}
		}
		node2 := forest[min2Idx]
		forest = delete(forest, min2Idx)

		// Create merged internal node
		parent := createInternal(node1, node2)
		forest = append(forest, parent)
	}

	root := forest[0]

	// Step 4: Build prefix codes
	codeTable = make([]CodeEntry, 0)
	buildCodes(root, "")

	// Sort codeTable by character order in uniqueChars for consistent output
	std::println("Huffman Prefix Codes:")
	for i := 0; i < len(uniqueChars); i++ {
		ch := uniqueChars[i]
		printf("  '%c' -> %s\n", ch, getCode(ch))
	}
	std::println("")

	// Step 5: Encode text
	encoded := ""
	for i := 0; i < len(text); i++ {
		encoded += getCode(text[i])
	}

	std::println("Encoded Bitstream:")
	std::println(encoded)
	encBits := len(encoded)
	ratio := (1.0 - (real(encBits) / real(origBits))) * 100.0
	printf("Encoded length: %d bits (%.1f%% space saved)\n\n", encBits, ratio)

	// Step 6: Decode bitstream
	decoded := ""
	curr := root
	for i := 0; i < len(encoded); i++ {
		bit := encoded[i]
		if bit == '0' {
			curr = curr.left
		} else {
			curr = curr.right
		}

		if curr.isLeaf {
			decoded += str(curr.ch)
			curr = root
		}
	}

	std::println("Decoded String:")
	printf("\"%s\"\n\n", decoded)

	if decoded == text {
		std::println("Verification: PASS (Decoded matches original exactly)")
	} else {
		std::println("Verification: FAIL (Mismatch)")
	}
}
